{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.*",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/fixtures/**/*",
      "!{projectRoot}/**/*.md"
    ],
    "sharedGlobals": ["{workspaceRoot}/nx.json", "{workspaceRoot}/policy/rules.json"]
  },
  "targetDefaults": {
    "validate": {
      "cache": true,
      "inputs": ["default", "sharedGlobals", "{workspaceRoot}/packages/validation/**/*"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.eslintrc*", "{workspaceRoot}/eslint.config.*"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["production", "^production", "{workspaceRoot}/tsconfig.base.json"]
    },
    "package": {
      "cache": true,
      "inputs": ["production", "^production", "sharedGlobals"],
      "outputs": ["{workspaceRoot}/dist/tools/{projectName}"]
    },
    "validate-package": {
      "cache": true,
      "inputs": ["production", "sharedGlobals"],
      "dependsOn": ["package"]
    },
    "security-check": {
      "cache": true,
      "inputs": ["default", "sharedGlobals", "{workspaceRoot}/packages/validation/**/*"]
    },
    "privacy-check": {
      "cache": true,
      "inputs": ["default", "sharedGlobals", "{workspaceRoot}/packages/validation/**/*"]
    },
    "policy-check": {
      "cache": true,
      "inputs": ["default", "sharedGlobals", "{workspaceRoot}/packages/validation/**/*"]
    }
  },
  "release": {
    "projects": ["tools/*/*/*"],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "versionPlans": true,
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": true
    },
    "git": {
      "commitMessage": "chore(release): {projectName}@{version}"
    }
  }
}
