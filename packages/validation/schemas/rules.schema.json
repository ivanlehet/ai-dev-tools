{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-dev-tools/schemas/rules.schema.json",
  "title": "Policy rules",
  "type": "object",
  "required": ["policyVersion", "rules"],
  "properties": {
    "policyVersion": { "type": "integer" },
    "description": { "type": "string" },
    "severities": { "type": "array", "items": { "type": "string" } },
    "categories": { "type": "object" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "category", "severity", "blocking", "enforcement", "appliesTo", "summary"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z]+[0-9]{3}$" },
          "category": { "type": "string" },
          "severity": { "enum": ["error", "warning", "info"] },
          "blocking": { "type": "boolean" },
          "enforcement": { "enum": ["automated", "attested"] },
          "appliesTo": { "type": "array", "items": { "type": "string" } },
          "summary": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    }
  }
}
